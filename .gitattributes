# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# PHP
*.php text eol=lf

# JavaScript / React
*.js   text eol=lf
*.jsx  text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.html text eol=lf

# Config
*.env.example text eol=lf
*.gitignore   text eol=lf
*.md          text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf

# Binary files — never touch line endings
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.svg  binary
*.ttf  binary
*.woff binary
*.woff2 binary
*.zip  binary
*.pdf  binary
